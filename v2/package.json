{
  "name": "tang-kinh-cac-v2",
  "private": true,
  "type": "module",
  "description": "Tàng Kinh Các v2 – Astro SSG + MDX + Pagefind, xuất toàn bộ HTML tĩnh",
  "scripts": {
    "anh": "node scripts/process-images.mjs",
    "dev": "node scripts/process-images.mjs && astro dev",
    "build": "node scripts/process-images.mjs && astro build && pagefind --site dist",
    "preview": "astro preview"
  },
  "engines": {
    "node": ">=22.23"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/mdx": "8.1.2",
    "astro": "7.4.5",
    "gray-matter": "4.0.3",
    "mdast-util-to-string": "4.0.0",
    "pagefind": "1.6.0",
    "sharp": "0.35.5",
    "unist-util-visit": "5.2.0",
    "unist-util-visit-parents": "6.0.2"
  }
}
