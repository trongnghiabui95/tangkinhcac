---
import { BIEU_TUONG } from '../lib/bieu-tuong.js';
interface Props { ten: string; class?: string }
const { ten, class: lop } = Astro.props;
---
<svg class:list={['bieu-tuong', lop]} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={BIEU_TUONG[ten] ?? ''} />
