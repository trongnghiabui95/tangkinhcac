---
// Danh sách nhân vật 1 bộ truyện, 24 thẻ/trang. Dùng cho trang 1 và các trang tiếp theo.
import BoCuc from '../layouts/BoCuc.astro';
import Breadcrumb from './Breadcrumb.astro';
import CharacterCardImage from './CharacterCardImage.astro';
import PhanTrang from './PhanTrang.astro';
import { layAnh, url, urlBai, NHAN, MOI_TRANG } from '../lib/tien-ich.js';
const { tp, ds, trang, tongTrang, truyen } = Astro.props;
const tenTruyen = tp?.data.ten ?? truyen;
const tieuDe = `Nhân vật ${tenTruyen}${trang > 1 ? ` – Trang ${trang}` : ''}`;
---
<BoCuc tieuDe={tieuDe} moTa={`Danh sách nhân vật trong ${tenTruyen}: tiểu sử, cảnh giới, pháp bảo và mối quan hệ.${trang > 1 ? ` Trang ${trang}.` : ''}`}>
  <Breadcrumb cap={[{ ten: 'Trang chủ', href: url('') }, { ten: tenTruyen, href: url(`${truyen}/`) }, { ten: 'Nhân vật' }]} />
  <h1>{tieuDe}</h1>
  <ul class="luoi-the">{ds.map((c, i) => (
    <li><CharacterCardImage anh={layAnh(c.id)} alt={c.data.ten} ten={c.data.ten} nhan={NHAN.vai_tro[c.data.vai_tro]} gon href={urlBai(c.id)} uuTien={i < 2} /></li>
  ))}</ul>
  <PhanTrang trang={trang} tongTrang={tongTrang} urlGoc={url(`${truyen}/nhan-vat/`)} />
</BoCuc>
