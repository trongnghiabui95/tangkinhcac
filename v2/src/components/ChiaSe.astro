---
// Nút chia sẻ (Issue #103) – không dùng thư viện/SDK ngoài, không theo dõi người đọc.
//  · Facebook: link chia sẻ thường (tắt JavaScript vẫn bấm được)
//  · "Chia sẻ…": bảng chia sẻ của điện thoại (Zalo, Messenger, Telegram…) – chỉ hiện khi trình duyệt hỗ trợ
//  · "Sao chép link": chép địa chỉ trang
import BieuTuong from './BieuTuong.astro';
interface Props { tieuDe: string; url: string }
const { tieuDe, url } = Astro.props;
const fb = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---
<div class="chia-se" data-url={url} data-tieu-de={tieuDe} data-pagefind-ignore="all">
  <span class="chia-se-nhan">Chia sẻ bài này:</span>
  <button type="button" class="nut-chia-se chia-se-may" hidden><BieuTuong ten="chia-se" />Chia sẻ…</button>
  <a class="nut-chia-se chia-se-fb" href={fb} target="_blank" rel="noopener nofollow"><BieuTuong ten="facebook" />Facebook</a>
  <button type="button" class="nut-chia-se chia-se-chep" hidden><BieuTuong ten="lien-ket" /><span>Sao chép link</span></button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.chia-se').forEach((k) => {
    const url = k.dataset.url!, title = k.dataset.tieuDe!;
    const may = k.querySelector<HTMLButtonElement>('.chia-se-may')!, chep = k.querySelector<HTMLButtonElement>('.chia-se-chep')!;
    if (navigator.share) { may.hidden = false; may.addEventListener('click', () => navigator.share({ title, url }).catch(() => {})); }
    if (navigator.clipboard) {
      chep.hidden = false;
      chep.addEventListener('click', async () => {
        const chu = chep.querySelector('span')!;
        try { await navigator.clipboard.writeText(url); chu.textContent = 'Đã sao chép ✓'; } catch { chu.textContent = 'Không chép được'; }
        setTimeout(() => (chu.textContent = 'Sao chép link'), 2000);
      });
    }
  });
</script>
