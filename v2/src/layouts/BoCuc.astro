---
/**
 * BoCuc – khung chung mọi trang: <head> SEO (title, description, canonical, Open Graph, Twitter, JSON-LD),
 * menu, chân trang (miễn trừ trách nhiệm + logo yendan), script AdSense (chỉ khi có mã).
 */
import '../styles/phong-chu.css';
import '../styles/giao-dien.css';
import DisclaimerBanner from '../components/DisclaimerBanner.astro';
import BieuTuong from '../components/BieuTuong.astro';
import { url, layMenu } from '../lib/tien-ich.js';

interface Props {
  tieuDe: string;            // không gồm tên web
  moTa: string;
  anhOg?: string;            // đường dẫn tương đối, ví dụ anh/<series>/<slug>-<series>-og.jpg
  jsonLd?: (object | null)[];
  kieuOg?: 'website' | 'article';
  noindex?: boolean;
  tuKhoa?: string[];
  giuNguyenTieuDe?: boolean;  // true: <title> đúng bằng tieuDe (trang bài – title 50–65 ký tự đã tối ưu)
  ngayDang?: Date;            // trang bài: article:published_time
  ngayCapNhat?: Date;         // trang bài: article:modified_time
}
const { tieuDe, moTa, anhOg, jsonLd = [], kieuOg = 'website', noindex = false, tuKhoa = [], giuNguyenTieuDe = false, ngayDang, ngayCapNhat } = Astro.props;
const menu = await layMenu();   // sinh từ nội dung: bộ truyện + danh mục đang có bài
const XEM_NHAP = (import.meta.env.XEM_NHAP ?? process.env.XEM_NHAP) === '1';
const TEN_WEB = 'Tu Chân Bảo Điển';
const title = giuNguyenTieuDe || tieuDe === TEN_WEB ? tieuDe : `${tieuDe} – ${TEN_WEB}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = anhOg ? new URL(url(anhOg), Astro.site).href : undefined;
const adsense = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const ld = jsonLd.filter(Boolean);
// Menu ngang kiểu web cũ – sinh từ nội dung (danh mục đang có bài, bộ truyện)
const duongDan = Astro.url.pathname;
const dangMo = (href: string) => (href === url('') ? duongDan === href : duongDan.startsWith(href));
const mucDau = { ten: 'Trang chủ', href: url(''), bieuTuong: 'trang-chu' };
// Sau các nhóm loại truyện: Đề cử, Thuật ngữ (khi có dữ liệu), Tìm kiếm
const mucSau = [
  ...(menu.deCu ? [{ ten: 'Đề cử', href: menu.deCu, bieuTuong: 'de-cu' }] : []),
  ...(menu.thuatNgu ? [{ ten: 'Thuật ngữ', href: menu.thuatNgu, bieuTuong: 'thuat-ngu' }] : []),
  { ten: 'Tìm kiếm', href: url('tim-kiem/'), bieuTuong: 'tim-kiem' },
];
const trongLoai = (l: any) => duongDan.startsWith(l.href) || l.series.some((s: any) => duongDan.startsWith(s.href));
---
<!doctype html>
<html lang="vi" data-theme="toi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Phông tự lưu cùng tên miền (scripts/tai-phong-chu.mjs): tải trước 4 file hay dùng nhất để chữ không "nhảy" (CLS) -->
  {['be-vietnam-pro-400-latin', 'be-vietnam-pro-400-vietnamese', 'noto-serif-700-latin', 'noto-serif-700-vietnamese'].map((f) =>
    <link rel="preload" href={url(`phong/${f}.woff2`)} as="font" type="font/woff2" crossorigin />)}
  <title>{title}</title>
  <meta name="description" content={moTa} />
  {tuKhoa.length > 0 && <meta name="keywords" content={tuKhoa.join(', ')} />}
  {XEM_NHAP && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:site_name" content={TEN_WEB} />
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:type" content={kieuOg} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={moTa} />
  <meta property="og:url" content={canonical} />
  {og && <meta property="og:image" content={og} />}
  {og && <meta property="og:image:width" content="1200" />}
  {og && <meta property="og:image:height" content="630" />}
  {og && <meta name="twitter:image" content={og} />}
  {ngayDang && <meta property="article:published_time" content={ngayDang.toISOString()} />}
  {ngayCapNhat && <meta property="article:modified_time" content={ngayCapNhat.toISOString()} />}
  <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={url('sitemap-index.xml')} />
  <script is:inline>try{var t=localStorage.getItem('tkc2-giao-dien');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {adsense && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`} crossorigin="anonymous"></script>}
</head>
<body>
  <a class="bo-qua" href="#noi-dung">Bỏ qua tới nội dung</a>
  <header class="dau-trang">
    <div class="khung dau-trang-hang">
      <a class="logo" href={url('')}><img class="logo-dau" src={url('favicon.svg')} alt="" width="36" height="36" />{TEN_WEB}</a>
      <form class="o-tim-dau" action={url('tim-kiem/')} role="search">
        <BieuTuong ten="tim-kiem" />
        <input type="search" name="q" placeholder="Tìm truyện, nhân vật, pháp bảo…" aria-label="Tìm kiếm" />
      </form>
      <button type="button" class="nut-giao-dien" aria-label="Đổi giao diện sáng/tối" title="Sáng / Tối"><BieuTuong ten="mat-troi" class="khi-toi" /><BieuTuong ten="mat-trang" class="khi-sang" /></button>
      <details class="menu-dt">
        <summary aria-label="Mở menu"><BieuTuong ten="menu" /></summary>
        <nav aria-label="Menu (điện thoại)" class="menu-dt-noi-dung">
          <form action={url('tim-kiem/')} role="search" class="o-tim-dt"><BieuTuong ten="tim-kiem" /><input type="search" name="q" placeholder="Tìm truyện, nhân vật…" aria-label="Tìm kiếm" /></form>
          <a href={mucDau.href} class:list={{ 'dang-mo': duongDan === mucDau.href }} aria-current={duongDan === mucDau.href ? 'page' : undefined}><BieuTuong ten={mucDau.bieuTuong} />{mucDau.ten}</a>
          {menu.loai.map((l) => (
            <details class="dt-nhom" open={trongLoai(l)}>
              <summary class:list={{ 'dang-mo': trongLoai(l) }}><BieuTuong ten={l.loai} />{l.ten}<BieuTuong ten="xuong" class="mui-ten" /></summary>
              <div class="dt-nhom-than">
                <a class="dt-tat-ca" href={l.href}>Tất cả {l.ten.toLowerCase()} ({l.series.length})</a>
                {l.series.map((s) => (
                  <div class="dt-bo">
                    <a class:list={['dt-bo-ten', { 'dang-mo': duongDan.startsWith(s.href) }]} href={s.href}><BieuTuong ten="bo-truyen" />{s.ten}</a>
                    {s.danhMuc.length > 0 && <ul class="dt-danh-muc">{s.danhMuc.map((c) => <li><a href={c.href} class:list={{ 'dang-mo': duongDan.startsWith(c.href) }}><BieuTuong ten={c.c} />{c.ten}</a></li>)}</ul>}
                  </div>
                ))}
              </div>
            </details>
          ))}
          {mucSau.map((m) => <a href={m.href} class:list={{ 'dang-mo': dangMo(m.href) }} aria-current={duongDan === m.href ? 'page' : undefined}><BieuTuong ten={m.bieuTuong} />{m.ten}</a>)}
        </nav>
      </details>
    </div>
    <nav aria-label="Menu chính" class="khung menu-ngang">
      <a href={mucDau.href} class:list={{ 'dang-mo': duongDan === mucDau.href }} aria-current={duongDan === mucDau.href ? 'page' : undefined}><BieuTuong ten={mucDau.bieuTuong} />{mucDau.ten}</a>
      {menu.loai.map((l) => (
        <details class="menu-con menu-loai">
          <summary class:list={{ 'dang-mo': trongLoai(l) }}><BieuTuong ten={l.loai} />{l.ten}</summary>
          <div class="bang-menu">
            <a class="bang-menu-tat-ca" href={l.href}>Tất cả {l.ten.toLowerCase()} ({l.series.length}) →</a>
            <div class="bang-menu-luoi">{l.series.map((s) => (
              <div class="bang-menu-bo">
                <a class="bang-menu-ten" href={s.href}><BieuTuong ten="bo-truyen" />{s.ten}</a>
                {s.danhMuc.length > 0 && <ul>{s.danhMuc.map((c) => <li><a href={c.href}><BieuTuong ten={c.c} />{c.ten}</a></li>)}</ul>}
              </div>
            ))}</div>
          </div>
        </details>
      ))}
      {mucSau.map((m) => <a href={m.href} class:list={{ 'dang-mo': dangMo(m.href) }} aria-current={duongDan === m.href ? 'page' : undefined}><BieuTuong ten={m.bieuTuong} />{m.ten}</a>)}
    </nav>
  </header>
  {XEM_NHAP && <p class="bang-xem-nhap">Bản xem thử có cả bài nháp (XEM_NHAP=1) – không đăng bản này.</p>}
  <main id="noi-dung" class="khung"><slot /></main>
  <footer class="chan-trang">
    <div class="khung">
      <DisclaimerBanner />
      <p class="thuong-hieu">Một sản phẩm của <img class="khi-toi" src={url('yendan.svg')} alt="yendan" width="84" height="32" loading="lazy" /><img class="khi-sang" src={url('yendan-sang.svg')} alt="yendan" width="84" height="32" loading="lazy" /></p>
      <p class="ban-quyen">© {new Date().getFullYear()} {TEN_WEB}</p>
    </div>
  </footer>
  <script>
    // Nút sáng/tối (nhớ lựa chọn)
    document.querySelector('.nut-giao-dien')?.addEventListener('click', () => {
      const h = document.documentElement; h.dataset.theme = h.dataset.theme === 'sang' ? 'toi' : 'sang';
      try { localStorage.setItem('tkc2-giao-dien', h.dataset.theme); } catch (e) {}
    });
    // Đóng menu điện thoại / menu con khi bấm ra ngoài hoặc nhấn Esc
    // (chỉ đóng menu không chứa chỗ vừa bấm – để bấm mở nhóm con trong menu điện thoại không làm đóng cả menu)
    const dongMenu = (cho?: Node | null) => document.querySelectorAll('details.menu-dt[open], details.menu-con[open]').forEach((d) => { if (!cho || !d.contains(cho)) d.removeAttribute('open'); });
    document.addEventListener('click', (e) => dongMenu(e.target as Node));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') dongMenu(); });
    // AdSense: chỉ yêu cầu quảng cáo khi ô sắp lọt vào màn hình (đỡ tốn tài nguyên, đúng chính sách hiển thị)
    const ins = document.querySelectorAll('ins.adsbygoogle');
    if (ins.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((ds) => ds.forEach((d) => {
        if (!d.isIntersecting) return;
        io.unobserve(d.target);
        try { ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({}); } catch (e) {}
      }), { rootMargin: '300px 0px' });
      ins.forEach((el) => io.observe(el));
    }
  </script>
</body>
</html>
