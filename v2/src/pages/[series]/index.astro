---
// Trang bộ truyện: /<series>/ – đủ các mục của trang review web cũ (Issue #51), mục nào không có dữ liệu thì tự ẩn:
// băng rôn · đánh giá · nội dung index.mdx · nhân vật chính/phụ/phản diện · các danh mục khác · bản đồ & địa điểm
// · hành trình nhân vật chính · thư viện ảnh · OST · thuật ngữ · tác phẩm tương tự
// Issue #11: thẻ "Bạn có biết" (ban_co_biet) · "Xếp hạng sức mạnh" (bac của nhân vật × cac_bac của bài cảnh giới cùng bộ)
import { render } from 'astro:content';
import BoCuc from '../../layouts/BoCuc.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BangRon from '../../components/BangRon.astro';
import TieuDeKhoi from '../../components/TieuDeKhoi.astro';
import LuoiBai from '../../components/LuoiBai.astro';
import AdUnit from '../../components/AdUnit.astro';
import DanhGia from '../../components/DanhGia.astro';
import DongThoiGian from '../../components/DongThoiGian.astro';
import ThuVienAnh from '../../components/ThuVienAnh.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import BieuTuong from '../../components/BieuTuong.astro';
import TheBoTruyen from '../../components/TheBoTruyen.astro';
import ChiaSe from '../../components/ChiaSe.astro';
import ChipNhanVat from '../../components/ChipNhanVat.astro';
import { laySeries, slugSeries, layBai, layAnhSeries, layThuVien, layBanDo, url, urlSeriesDanhMuc, urlVuTru, urlTheLoai, urlLoai, boDau,
  DANH_MUC, CAC_DANH_MUC, LOAI_TRUYEN, NHAN_VAI_TRO, cacVuTru, cacBanKhac, urlSeries, taoSlug, tenBai, urlBai } from '../../lib/tien-ich.js';
import { GIOI_HAN } from '../../lib/chuan-mdx.mjs';
import { schemaReviewTruyen, schemaBreadcrumb } from '../../lib/schema.js';
export async function getStaticPaths() {
  return (await laySeries()).map((s) => ({ params: { series: slugSeries(s) }, props: { s } }));
}
const { s } = Astro.props;
const d = s.data;
const slug = slugSeries(s);
const { Content, headings } = await render(s);
const tatCaSeries = await laySeries();
const bai = await layBai((e) => e.data.series === slug);
const theoThuTu = (a: any, b: any) => (a.data.thu_tu ?? 999) - (b.data.thu_tu ?? 999);
const nhanVat = bai.filter((b) => b.data.category === 'nhan-vat');
// Nhân vật chia theo vai trò như web cũ (không ghi vai trò → nhóm "phụ")
const nhomNhanVat = [
  { id: 'nhan-vat-chinh', ten: 'Nhân vật chính', ds: nhanVat.filter((b) => b.data.vai_tro === 'chinh') },
  { id: 'nhan-vat-phu', ten: 'Nhân vật phụ', ds: nhanVat.filter((b) => !b.data.vai_tro || b.data.vai_tro === 'phu' || b.data.vai_tro === 'lien-quan') },
  { id: 'phan-dien', ten: NHAN_VAI_TRO['phan-dien'], ds: nhanVat.filter((b) => b.data.vai_tro === 'phan-dien') },
].filter((n) => n.ds.length);
const nhom = CAC_DANH_MUC.filter((c) => c !== 'nhan-vat').map((c) => ({ c, ds: bai.filter((b) => b.data.category === c).sort(theoThuTu) })).filter((n) => n.ds.length);
const vuTru = (await cacVuTru()).find((v) => v.slug === d.universe);
// Issue #4: nút sang bản khác loại cùng vũ trụ (chữ nút lấy từ LOAI_TRUYEN[...].nut)
const banKhac = (await cacBanKhac(s)).map((x) => ({ href: urlSeries(slugSeries(x)), chu: LOAI_TRUYEN[x.data.loai].nut, loai: x.data.loai, ten: x.data.ten }));
const anh = layAnhSeries(s);
const banDo = layBanDo(s);
const thuVien = layThuVien(s);
const tuongTu = d.tuong_tu.map((t) => ({ ...t, s: tatCaSeries.find((x) => slugSeries(x) === t.series) })).filter((t) => t.s);
const coBanDo = banDo || d.dia_diem.length > 0;

// "Bạn có biết": in sẵn mọi ý, ẩn bớt chỉ giữ GIOI_HAN.banCoBietHien ý đầu (không JS vẫn đọc được);
// có nhiều hơn thì script nhỏ ở cuối trang chọn ngẫu nhiên mỗi lượt xem.
const banCoBiet = d.ban_co_biet;
// "Xếp hạng sức mạnh": thứ tự bậc lấy từ cac_bac của bài cảnh giới cùng bộ (bài đầu tiên theo thu_tu có cac_bac),
// nhân vật có `bac` khớp tên bậc (so không dấu) mới được xếp; cùng bậc thì cùng hạng.
const baiCanhGioi = bai.filter((b) => b.data.category === 'canh-gioi' && b.data.cac_bac.length).sort(theoThuTu)[0];
const viTriBac = new Map((baiCanhGioi?.data.cac_bac ?? []).map((b, i) => [taoSlug(b.ten), i]));
const xepHang = nhanVat
  .map((e) => ({ e, i: e.data.bac ? viTriBac.get(taoSlug(e.data.bac)) : undefined }))
  .filter((x) => x.i !== undefined)
  .sort((a, b) => b.i! - a.i! || (a.e.data.vai_tro === 'chinh' ? -1 : 0) - (b.e.data.vai_tro === 'chinh' ? -1 : 0) || tenBai(a.e).localeCompare(tenBai(b.e), 'vi'))
  .map((x, k, ds) => ({ ...x, hang: ds.findIndex((y) => y.i === x.i) + 1, tenBac: baiCanhGioi!.data.cac_bac[x.i!].ten }));
const coXepHang = xepHang.length >= GIOI_HAN.xepHangToiThieu;

// Mục lục: chỉ những mục có dữ liệu
const mucLuc = [
  (d.diem != null || d.diem_chi_tiet) && { id: 'danh-gia', ten: 'Đánh giá' },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, ten: h.text })),
  banCoBiet.length > 0 && { id: 'ban-co-biet', ten: 'Bạn có biết' },
  ...nhomNhanVat.map((n) => ({ id: n.id, ten: n.ten })),
  coXepHang && { id: 'xep-hang-suc-manh', ten: 'Xếp hạng sức mạnh' },
  ...nhom.map((n) => ({ id: n.c, ten: DANH_MUC[n.c].tenSoNhieu })),
  coBanDo && { id: 'ban-do', ten: 'Bản đồ thế giới' },
  d.hanh_trinh.length > 0 && { id: 'hanh-trinh', ten: 'Hành trình nhân vật chính' },
  thuVien.length > 0 && { id: 'thu-vien-anh', ten: 'Thư viện ảnh' },
  d.ost.length > 0 && { id: 'ost', ten: 'OST' },
  d.thuat_ngu.length > 0 && { id: 'thuat-ngu', ten: 'Thuật ngữ' },
  tuongTu.length > 0 && { id: 'tuong-tu', ten: 'Tác phẩm tương tự' },
].filter(Boolean) as { id: string; ten: string }[];

const site = Astro.site!;
const tuyetDoi = (p: string) => new URL(p, site).href;
const tieuDe = `[Review] ${d.ten} | Cốt truyện, Nhân vật, Thế giới`;
const jsonLd = [
  schemaReviewTruyen({ ten: d.ten, tacGia: d.tac_gia, moTa: d.mo_ta, urlTrang: tuyetDoi(url(`${slug}/`)), anh: anh ? tuyetDoi(url(anh.src)) : undefined, diem: d.diem,
    ngayDang: d.ngay_dang.toISOString(), ngayCapNhat: d.ngay_cap_nhat.toISOString(), site: site.href }),
  schemaBreadcrumb([{ ten: 'Trang chủ', url: tuyetDoi(url('')) }, { ten: d.ten, url: tuyetDoi(url(`${slug}/`)) }]),
];
const dong = (ten: string, v: unknown) => (v == null || v === '' ? null : { ten, v: String(v) });
const thongTin = [
  dong('Tên gốc', d.ten_trung), d.ten_khac.length ? dong('Tên khác', d.ten_khac.join(', ')) : null, dong('Tác giả', d.tac_gia),
  dong('Loại', LOAI_TRUYEN[d.loai]?.ten), dong('Tình trạng', d.tinh_trang), dong('Số chương', d.so_chuong?.toLocaleString('vi-VN')),
  dong('Số tập', d.so_tap), dong('Số mùa', d.so_mua), dong('Nền tảng', d.nen_tang), dong('Năm', d.nam), dong('Studio', d.studio),
  d.diem != null ? dong('Điểm', `★ ${d.diem}/10`) : null, dong('Số bài', bai.length),
].filter(Boolean) as { ten: string; v: string }[];
---
<BoCuc tieuDe={tieuDe} moTa={d.mo_ta} anhOg={anh?.og} jsonLd={jsonLd} kieuOg="article" giuNguyenTieuDe>
  <Breadcrumb cap={[{ ten: 'Trang chủ', href: url('') }, { ten: LOAI_TRUYEN[d.loai].ten, href: urlLoai(d.loai) }, { ten: d.ten }]} />
  <article data-pagefind-body data-pagefind-filter={`truyen:${d.ten}`} data-pagefind-meta="loai:Bộ truyện">
    <span hidden data-pagefind-meta={`title:${tieuDe}`}></span>
    <BangRon s={s} laTieuDe nut={false} />
    {vuTru && vuTru.series.length > 1 && <p class="thuoc-bo">Thuộc vũ trụ <a href={urlVuTru(d.universe)}>{vuTru.ten}</a></p>}
    {banKhac.length > 0 && <p class="ban-khac" data-pagefind-ignore>{banKhac.map((b) => <a class="nut-vien" href={b.href} title={b.ten}><BieuTuong ten={b.loai} />{b.chu}</a>)}</p>}
    <span class="sr-only" data-pagefind-weight="8">{boDau([d.ten, ...d.ten_khac].join(' ')).toLowerCase()}</span>
    {mucLuc.length >= 3 && <nav aria-label="Mục lục" data-pagefind-ignore><ul class="muc-luc-ngang">{mucLuc.map((m) => <li><a href={`#${m.id}`}>{m.ten}</a></li>)}</ul></nav>}

    <div class="bo-cuc-bai">
      <aside class="cot-phu"><div class="infobox" data-pagefind-ignore>
        <p class="infobox-tieu-de">{d.ten}</p>
        <table><tbody>
          {thongTin.map((t) => <tr><th scope="row">{t.ten}</th><td>{t.v}</td></tr>)}
          <tr><th scope="row">Thể loại</th><td>{d.the_loai.map((tl, i) => <>{i > 0 && ', '}<a href={urlTheLoai(tl)}>{tl}</a></>)}</td></tr>
        </tbody></table>
        {anh?.nguon && <p class="infobox-nguon nguon-anh" title={`Ảnh bìa: ${anh.nguon}`}>Ảnh bìa: {anh.nguon_url ? <a href={anh.nguon_url} rel="nofollow noopener" target="_blank">{anh.nguon}</a> : anh.nguon}</p>}
      </div></aside>
      <div class="noi-dung-bai">
        {(d.diem != null || d.diem_chi_tiet) && <section id="danh-gia" data-pagefind-ignore><h2>Đánh giá</h2><DanhGia diem={d.diem} chiTiet={d.diem_chi_tiet} /></section>}
        <div class="muc" data-pagefind-ignore="all"><Content /></div>
        <ChiaSe tieuDe={tieuDe} url={tuyetDoi(url(`${slug}/`))} />
      </div>
    </div>
  </article>
  <AdUnit viTri="sau-review" />

  {banCoBiet.length > 0 && (
    <section class="khoi" id="ban-co-biet" data-pagefind-ignore="all">
      <TieuDeKhoi tieuDe="Bạn có biết" bieuTuong="y-tuong" />
      <ul class="ban-co-biet" data-hien={GIOI_HAN.banCoBietHien}>{banCoBiet.map((y, i) => (
        <li hidden={i >= GIOI_HAN.banCoBietHien}>
          <p>{y.noi_dung}</p>
          {y.nguon && <p class="nguon-anh" title={`Nguồn: ${y.nguon}`}>Nguồn: {y.nguon_url ? <a href={y.nguon_url} rel="nofollow noopener" target="_blank">{y.nguon}</a> : y.nguon}</p>}
        </li>
      ))}</ul>
      {banCoBiet.length > GIOI_HAN.banCoBietHien && <script is:inline>{`(()=>{const u=document.querySelector('.ban-co-biet');if(!u)return;const n=+u.dataset.hien||3,ds=[...u.children];for(let i=ds.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[ds[i],ds[j]]=[ds[j],ds[i]];}ds.forEach((li,i)=>{li.hidden=i>=n;});})();`}</script>}
    </section>
  )}

  {nhomNhanVat.map((n) => (
    <section class="khoi" id={n.id} data-pagefind-ignore="all">
      <TieuDeKhoi tieuDe={n.ten} bieuTuong="nhan-vat" />
      <LuoiBai ds={n.ds.slice(0, 10)} />
    </section>
  ))}
  {nhanVat.length > 10 && <p><a class="nut-vien" href={urlSeriesDanhMuc(slug, 'nhan-vat')}>Xem tất cả {nhanVat.length} nhân vật</a></p>}

  {coXepHang && (
    <section class="khoi" id="xep-hang-suc-manh" data-pagefind-ignore="all">
      <TieuDeKhoi tieuDe="Xếp hạng sức mạnh" bieuTuong="xep-hang" href={urlBai(baiCanhGioi)} chuNut="Các bậc" />
      <p class="xep-hang-ghi-chu">Xếp theo cảnh giới cao nhất mỗi nhân vật đạt được trong truyện (có thể chứa spoiler); cùng cảnh giới thì cùng hạng.</p>
      <ol class="xep-hang">{xepHang.map((x) => (
        <li><span class="xep-hang-so" aria-label={`Hạng ${x.hang}`}>{x.hang}</span><ChipNhanVat bai={x.e} phu={x.tenBac} /></li>
      ))}</ol>
    </section>
  )}

  {nhom.map((n) => (
    <section class="khoi" id={n.c} data-pagefind-ignore="all">
      <TieuDeKhoi tieuDe={DANH_MUC[n.c].tenSoNhieu} bieuTuong={n.c} href={n.ds.length > 10 ? urlSeriesDanhMuc(slug, n.c) : undefined} chuNut={`Xem tất cả ${n.ds.length}`} />
      <LuoiBai ds={n.ds.slice(0, 10)} />
    </section>
  ))}

  {coBanDo && (
    <section class="khoi" id="ban-do" data-pagefind-ignore="all">
      <TieuDeKhoi tieuDe="Bản đồ thế giới" bieuTuong="ban-do" />
      {banDo && (
        <figure class="ban-do">
          <img src={url(banDo.src)} srcset={banDo.srcset.map((x: any) => `${url(x.src)} ${x.w}w`).join(', ')} sizes="(max-width: 1240px) 100vw, 1200px" width={banDo.width} height={banDo.height} alt={`Bản đồ thế giới ${d.ten}`} loading="lazy" />
          <figcaption class="nguon-anh" title={`Ảnh: ${banDo.nguon}`}>Ảnh: {banDo.nguon_url ? <a href={banDo.nguon_url} rel="nofollow noopener" target="_blank">{banDo.nguon}</a> : banDo.nguon}</figcaption>
        </figure>
      )}
      {d.dia_diem.length > 0 && <ul class="ds-dia-diem">{d.dia_diem.map((x) => (
        <li><b>{x.ten}</b>{(x.cap || x.thuoc) && <span class="phu"> · {[x.cap, x.thuoc && `thuộc ${x.thuoc}`].filter(Boolean).join(', ')}</span>}<br />{x.mo_ta}</li>
      ))}</ul>}
    </section>
  )}

  {d.hanh_trinh.length > 0 && (
    <section class="khoi" id="hanh-trinh" data-pagefind-ignore="all">
      <TieuDeKhoi tieuDe="Hành trình nhân vật chính" bieuTuong="hanh-trinh" />
      <DongThoiGian ds={d.hanh_trinh.map((h) => ({ diaDiem: h.dia_diem, canhGioi: h.canh_gioi, noiDung: h.su_kien }))} />
    </section>
  )}

  {thuVien.length > 0 && (
    <section class="khoi" id="thu-vien-anh" data-pagefind-ignore="all">
      <TieuDeKhoi tieuDe="Thư viện ảnh" bieuTuong="anh" />
      <ThuVienAnh ds={thuVien} />
    </section>
  )}

  {d.ost.length > 0 && (
    <section class="khoi" id="ost" data-pagefind-ignore="all">
      <TieuDeKhoi tieuDe="OST" bieuTuong="nhac" />
      <div class="ost">{d.ost.map((o) => <YouTubeFacade id={o.youtube} tieuDe={o.ten} />)}</div>
    </section>
  )}

  {d.thuat_ngu.length > 0 && (
    <section class="khoi" id="thuat-ngu" data-pagefind-ignore="all">
      <TieuDeKhoi tieuDe="Thuật ngữ" bieuTuong="thuat-ngu" href={url('thuat-ngu/')} chuNut="Mọi thuật ngữ" />
      <dl class="ds-thuat-ngu">{d.thuat_ngu.map((t) => <><dt>{t.ten}</dt><dd>{t.giai_thich}</dd></>)}</dl>
    </section>
  )}

  {tuongTu.length > 0 && (
    <section class="khoi" id="tuong-tu" data-pagefind-ignore="all">
      <TieuDeKhoi tieuDe="Tác phẩm tương tự" bieuTuong="bo-truyen" />
      <ul class="luoi-the">{tuongTu.map((t) => <TheBoTruyen s={t.s} />)}</ul>
      <ul class="de-cu-cap" style="margin-top:16px">{tuongTu.map((t) => <li><p class="cap">Thích {d.ten} → đọc <a href={url(`${t.series}/`)}>{t.s.data.ten}</a></p><p>{t.ly_do}</p></li>)}</ul>
    </section>
  )}

  {!bai.length && <p class="trong khoi">Bộ truyện này chưa có bài viết đã xuất bản – các bài nhân vật, cảnh giới sẽ được bổ sung dần.</p>}
</BoCuc>
