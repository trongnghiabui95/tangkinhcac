---
/**
 * Trang bài viết: /<series>/<category>/<slug>/ – sinh từ v2/content/<series>/<category>/<slug>.mdx
 *  infobox (frontmatter `infobox` + ảnh) · mục lục từ `##` · khối FAQ từ `faqs` · nguồn ảnh có link
 *  · bài liên quan cùng bộ · JSON-LD Article + BreadcrumbList + FAQPage · quảng cáo cuối bài
 */
import { render } from 'astro:content';
import BoCuc from '../../../layouts/BoCuc.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CharacterCardImage from '../../../components/CharacterCardImage.astro';
import LuoiBai from '../../../components/LuoiBai.astro';
import AdUnit from '../../../components/AdUnit.astro';
import YouTubeFacade from '../../../components/YouTubeFacade.astro';
import DongThoiGian from '../../../components/DongThoiGian.astro';
import ThuVienAnh from '../../../components/ThuVienAnh.astro';
import ChipNhanVat from '../../../components/ChipNhanVat.astro';
import { layBai, laySeries, slugSeries, layAnh, layAnhSeries, tenBai, urlBai, urlSeries, urlSeriesDanhMuc, urlVuTru, url, boDau, DANH_MUC, NHAN_VAI_TRO, cacVuTru, timBai, layThuVien, nhanQuanHe, taoSlug } from '../../../lib/tien-ich.js';
import { schemaArticle, schemaBreadcrumb, schemaFaq } from '../../../lib/schema.js';

export async function getStaticPaths() {
  return (await layBai()).map((bai) => ({ params: { series: bai.data.series, category: bai.data.category, slug: bai.data.slug }, props: { bai } }));
}
const { bai } = Astro.props;
const d = bai.data;
const { Content, headings } = await render(bai);
const series = (await laySeries()).find((s) => slugSeries(s) === d.series);
const tenSeries = series?.data.ten ?? d.series;
const vuTru = (await cacVuTru()).find((v) => v.slug === d.universe);
const cungBo = await layBai((e) => e.data.series === d.series && e.id !== bai.id);
const theoTen = new Map(cungBo.flatMap((e) => [tenBai(e), ...e.data.aliases].map((t) => [t.toLowerCase(), e])));
const canhGioi = d.canh_gioi ? cungBo.find((e) => e.data.category === 'canh-gioi' && e.data.slug === d.canh_gioi) : undefined;
const phapBao = d.phap_bao.map((s) => cungBo.find((e) => e.data.category === 'phap-bao' && e.data.slug === s)).filter(Boolean);
// ---- Tính năng chuyển từ web cũ (Issue #51) ----
const nhanVatCungBo = cungBo.filter((e) => e.data.category === 'nhan-vat');
// Gộp nhiều quan hệ với cùng 1 người (vd. vừa là sư phụ vừa là kẻ thù) thành 1 dòng
const quanHe = [...d.quan_he.reduce((m, q) => {
  const cu = m.get(q.nhan_vat) || { nhan_vat: q.nhan_vat, quan_he: [] as string[], ghi_chu: [] as string[], bai: timBai(cungBo, q.nhan_vat, 'nhan-vat') };
  cu.quan_he.push(nhanQuanHe(q.quan_he)); if (q.ghi_chu) cu.ghi_chu.push(q.ghi_chu); return m.set(q.nhan_vat, cu);
}, new Map()).values()];
const theLuc = d.the_luc.map((t) => ({ ten: t, bai: timBai(cungBo, t, 'the-luc') }));
const thuVien = series && d.category === 'nhan-vat' ? layThuVien(series, d.slug) : [];
// Bài cảnh giới: nhân vật ở từng bậc (trường `bac` của bài nhân vật)
const bacThang = d.cac_bac.map((b, i) => ({ ...b, so: i + 1, nhanVat: nhanVatCungBo.filter((e) => e.data.bac && taoSlug(e.data.bac) === taoSlug(b.ten)) }));
// Bài thế lực: thủ lĩnh + thành viên (bài nhân vật có the_luc trùng slug hoặc tên thế lực)
const thuLinh = d.thu_linh ? timBai(cungBo, d.thu_linh, 'nhan-vat') : null;
const thanhVien = d.category === 'the-luc' ? nhanVatCungBo.filter((e) => e.data.the_luc.some((t) => t === d.slug || taoSlug(t) === taoSlug(tenBai(bai)))) : [];
const mucThem = [
  bacThang.length > 0 && { slug: 'cac-bac', text: 'Các bậc cảnh giới' },
  d.cuoc_doi.length > 0 && { slug: 'cuoc-doi', text: 'Cuộc đời' },
  quanHe.length > 0 && { slug: 'quan-he', text: 'Mối quan hệ' },
  theLuc.length > 0 && { slug: 'the-luc-thuoc', text: 'Thế lực' },
  thanhVien.length > 0 && { slug: 'thanh-vien', text: 'Thành viên' },
  thuVien.length > 0 && { slug: 'thu-vien-anh', text: 'Thư viện ảnh' },
].filter(Boolean) as { slug: string; text: string }[];
const lienQuan = [...cungBo.filter((e) => e.data.category === d.category), ...cungBo.filter((e) => e.data.category !== d.category)].slice(0, 8);

const anh = layAnh(bai);
// Bài không có ảnh riêng: JSON-LD/Open Graph dùng ảnh bìa bộ truyện (Google cần image cho Article)
const anhChiaSe = anh ?? (series ? layAnhSeries(series) : null);
const ten = tenBai(bai);
const tenDanhMuc = DANH_MUC[d.category].ten;
const huyHieu = canhGioi ? tenBai(canhGioi) : Object.entries(d.infobox).find(([k]) => /cảnh giới/i.test(k))?.[1]?.toString();
// Giá trị infobox trùng tên một bài cùng bộ → tự thành link
const giaTriInfobox = (v: string | number) => String(v).split(/,\s*/).map((p) => {
  const e = theoTen.get(p.trim().toLowerCase());
  return e ? `<a href="${urlBai(e)}">${p}</a>` : p.replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c]!));
}).join(', ');
const mucLuc = [...headings.filter((h) => h.depth === 2), ...mucThem];

const site = Astro.site!;
const tuyetDoi = (p: string) => new URL(p, site).href;
const cap = [
  { ten: 'Trang chủ', href: url('') },
  { ten: tenSeries, href: urlSeries(d.series) },
  { ten: DANH_MUC[d.category].tenSoNhieu, href: urlSeriesDanhMuc(d.series, d.category) },
  { ten },
];
const jsonLd = [
  schemaArticle({ title: d.title, description: d.description, urlTrang: tuyetDoi(urlBai(bai)), anh: anhChiaSe ? tuyetDoi(url(anhChiaSe.src)) : undefined, anhOg: anhChiaSe?.og ? tuyetDoi(url(anhChiaSe.og)) : undefined,
    date: d.date, updated: d.updated, keywords: d.keywords, site: site.href, tenSeries, urlSeries: tuyetDoi(urlSeries(d.series)),
    nhanVat: d.category === 'nhan-vat' ? { ten, aliases: d.aliases } : undefined }),
  schemaBreadcrumb(cap.map((c) => ({ ten: c.ten, url: tuyetDoi(c.href ?? urlBai(bai)) }))),
  schemaFaq(d.faqs),
];
const TIM_TOAN_VAN = (import.meta.env.TIM_TOAN_VAN ?? process.env.TIM_TOAN_VAN) === '1';
---
<BoCuc tieuDe={d.title} moTa={d.description} anhOg={anhChiaSe?.og} jsonLd={jsonLd} kieuOg="article" tuKhoa={d.keywords} giuNguyenTieuDe ngayDang={d.date} ngayCapNhat={d.updated}>
  <Breadcrumb cap={cap} />
  <article data-pagefind-body data-pagefind-filter={`truyen:${tenSeries}`} data-pagefind-meta={`loai:${tenDanhMuc}`}>
    <h1 data-pagefind-meta="title">{d.title}</h1>
    <p class="sapo">{d.description}</p>
    <p class="thuoc-bo">{tenDanhMuc} trong bộ <a href={urlSeries(d.series)}>{tenSeries}</a>
      {vuTru && vuTru.series.length > 1 && <> · Vũ trụ <a href={urlVuTru(d.universe)}>{vuTru.ten}</a></>}</p>
    <span class="sr-only" data-pagefind-weight="8">{boDau([ten, ...d.aliases, ...d.keywords].join(' ')).toLowerCase()}</span>
    {anh && <span hidden data-pagefind-meta={`image:${url(anh.srcset.at(-1)!.src)}`}></span>}
    {d.spoiler && <p class="canh-bao-spoiler" data-pagefind-ignore>⚠ Bài viết có tiết lộ nội dung (spoiler). Các đoạn quan trọng được thu gọn, bấm để mở.</p>}

    <div class="bo-cuc-bai">
      <aside class="cot-phu" aria-label="Thông tin">
        <div class="infobox" data-pagefind-ignore>
          <CharacterCardImage anh={anh} alt={`${ten} – ${tenDanhMuc.toLowerCase()} ${tenSeries}`} ten={ten} canhGioi={huyHieu}
                              nhan={d.vai_tro ? NHAN_VAI_TRO[d.vai_tro] : tenDanhMuc} uuTien sizes="(max-width: 960px) 90vw, 290px" />
          <table><tbody>
            {Object.entries(d.infobox).map(([k, v]) => <tr><th scope="row">{k}</th><td set:html={giaTriInfobox(v)} /></tr>)}
            {d.thu_linh && <tr><th scope="row">Thủ lĩnh</th><td>{thuLinh ? <a href={urlBai(thuLinh)}>{tenBai(thuLinh)}</a> : d.thu_linh}</td></tr>}
            {d.tru_so && <tr><th scope="row">Trụ sở</th><td>{d.tru_so}</td></tr>}
            <tr><th scope="row">Bộ truyện</th><td><a href={urlSeries(d.series)}>{tenSeries}</a></td></tr>
            <tr><th scope="row">Cập nhật</th><td><time datetime={d.updated.toISOString()}>{d.updated.toLocaleDateString('vi-VN')}</time></td></tr>
          </tbody></table>
        </div>
        {mucLuc.length >= 2 && (
          <nav class="muc-luc" aria-label="Mục lục" data-pagefind-ignore>
            <p class="muc-luc-tieu-de">Mục lục</p>
            <ol>{mucLuc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}<li><a href="#cau-hoi-thuong-gap">Câu hỏi thường gặp</a></li></ol>
          </nav>
        )}
      </aside>

      <div class="noi-dung-bai" data-pagefind-ignore={TIM_TOAN_VAN ? undefined : 'all'}>
        <Content />
        {bacThang.length > 0 && (
          <section id="cac-bac" class="khong-quang-cao"><h2>Các bậc cảnh giới</h2>
            <ol class="bac-thang">{bacThang.map((b, i) => <>
              {b.the_gioi && b.the_gioi !== bacThang[i - 1]?.the_gioi && <li class="nhom-the-gioi" aria-hidden="true">{b.the_gioi}</li>}
              <li><span class="bac-so">{b.so}</span><div class="bac-the"><h3>{b.ten}</h3><p>{b.mo_ta}</p>
                {b.nhanVat.length > 0 && <ul class="ds-chip">{b.nhanVat.map((e) => <li><ChipNhanVat bai={e} /></li>)}</ul>}</div></li>
            </>)}</ol>
          </section>
        )}
        {d.cuoc_doi.length > 0 && <section id="cuoc-doi" class="khong-quang-cao"><h2>Cuộc đời</h2>
          <DongThoiGian ds={d.cuoc_doi.map((c) => ({ tieuDe: c.giai_doan, diaDiem: c.dia_diem, canhGioi: c.canh_gioi, noiDung: c.su_kien }))} /></section>}
        {quanHe.length > 0 && <section id="quan-he" class="khong-quang-cao"><h2>Mối quan hệ</h2>
          <ul class="ds-quan-he">{quanHe.map((q) => <li><ChipNhanVat bai={q.bai} ten={q.nhan_vat} phu={q.quan_he.join(' · ')} />{q.ghi_chu.length > 0 && <span class="ghi-chu">{q.ghi_chu.join(' ')}</span>}</li>)}</ul></section>}
        {theLuc.length > 0 && <section id="the-luc-thuoc"><h2>Thế lực</h2>
          <ul class="chip-the-loai">{theLuc.map((t) => <li>{t.bai ? <a href={urlBai(t.bai)}>{t.ten}</a> : <span class="nhan nhan-the-luc">{t.ten}</span>}</li>)}</ul></section>}
        {thanhVien.length > 0 && <section id="thanh-vien" class="khong-quang-cao"><h2>Thành viên</h2>
          <ul class="ds-chip">{thanhVien.map((e) => <li><ChipNhanVat bai={e} phu={e.data.vai_tro ? NHAN_VAI_TRO[e.data.vai_tro] : undefined} /></li>)}</ul></section>}
        {thuVien.length > 0 && <section id="thu-vien-anh" class="khong-quang-cao"><h2>Thư viện ảnh</h2><ThuVienAnh ds={thuVien} /></section>}
        {d.youtube && <><h2>Video giới thiệu</h2><YouTubeFacade id={d.youtube} tieuDe={`${ten} – video`} /></>}
        {phapBao.length > 0 && <section class="khong-quang-cao"><h2>Pháp bảo của {ten}</h2><LuoiBai ds={phapBao} /></section>}
        <section class="faq" id="cau-hoi-thuong-gap">
          <h2>Câu hỏi thường gặp</h2>
          {d.faqs.map((c) => <div class="faq-cau"><h3>{c.q}</h3><p>{c.a}</p></div>)}
        </section>
      </div>
    </div>
  </article>

  <AdUnit viTri="cuoi-bai" maO={import.meta.env.PUBLIC_ADSENSE_SLOT_CUOI_BAI} />

  {lienQuan.length > 0 && (
    <section data-pagefind-ignore="all">
      <h2>Bài liên quan trong {tenSeries}</h2>
      <LuoiBai ds={lienQuan} />
      <p><a class="nut" href={urlSeries(d.series)}>Xem toàn bộ {tenSeries}</a></p>
    </section>
  )}
</BoCuc>
