---
import TrangDanhSach from '../../../components/TrangDanhSach.astro';
import { trangSeriesDanhMuc } from '../../../lib/danh-sach.js';
import { url, urlSeries, urlSeriesDanhMuc, danhMuc, chuDanhSach } from '../../../lib/tien-ich.js';
export async function getStaticPaths() {
  return (await trangSeriesDanhMuc()).filter((p) => p.trang === 1).map((p) => ({ params: { series: p.series, category: p.category }, props: p }));
}
const p = Astro.props;
const dm = danhMuc(p.category, p.loai);
const ten = `${dm.tenSoNhieu} ${p.tenSeries}`;
---
<TrangDanhSach tieuDe={ten} moTa={`Tổng hợp ${dm.tenSoNhieu.toLowerCase()} trong ${p.tenSeries}: ${chuDanhSach(p.loai)}.`}
  cap={[{ ten: 'Trang chủ', href: url('') }, { ten: p.tenSeries, href: urlSeries(p.series) }, { ten: dm.tenSoNhieu }]}
  ds={p.ds} trang={p.trang} tongTrang={p.tongTrang} urlGoc={urlSeriesDanhMuc(p.series, p.category)} />
